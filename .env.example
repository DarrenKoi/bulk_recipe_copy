# 복사해서 .env 로 쓰고 값을 채웁니다. .env 는 커밋하지 않습니다.

# 쉼표로 구분한 LASTUSER 값(MI 엔지니어 허용 목록)
BRC_ALLOWED_USERS=

# office Redis (장비 명부 v3_df_sem_avail, 읽기 전용)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# 장비 FTP 계정
BRC_FTP_USER=
BRC_FTP_PASSWORD=
BRC_FTP_ENCODING=utf-8

# 원본 탐색 요청 하나의 상한(기본 5초, LIST 항목 5000개)
# BRC_BROWSE_SECONDS=5
# BRC_BROWSE_MAX_ENTRIES=5000

# 동시 전송 스레드 합의 상한(job 대상 수 상한이기도 함)과 스냅샷 총량 상한
# BRC_MAX_THREADS=32
# BRC_SNAPSHOT_CAP_GB=20

# 파일 하나 전송(올리기·재다운로드 각각)의 시간·크기 상한과 연결이 끊겼을 때 재시도 횟수
# BRC_TRANSFER_SECONDS=60
# BRC_TRANSFER_MAX_MB=64
# BRC_TRANSFER_RETRIES=3

# SQLite 파일과 스냅샷 폴더가 놓일 곳(기본: 저장소의 var/)
# BRC_VAR_DIR=

# 1 이면 가짜 명부·가짜 장비로 뜹니다(집 개발 전용). 개발용 신원은 python index.py 실행이면 집·사무실 모두 씁니다
# BRC_DEV=1
