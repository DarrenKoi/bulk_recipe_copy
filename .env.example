# 복사해서 .env 로 쓰고 값을 채웁니다. .env 는 커밋하지 않습니다.

# 쉼표로 구분한 LASTUSER 값(MI 엔지니어 허용 목록)
BRC_ALLOWED_USERS=

# office Redis (장비 명부 v3_df_sem_list, 읽기 전용)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# 장비 FTP 계정
BRC_FTP_USER=
BRC_FTP_PASSWORD=
BRC_FTP_ENCODING=utf-8

# SQLite 파일과 스냅샷 폴더가 놓일 곳(기본: 저장소의 var/)
# BRC_VAR_DIR=

# 1 이면 가짜 명부와 개발용 신원으로 뜹니다(집 개발 전용)
# BRC_DEV=1
